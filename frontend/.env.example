# Frontend (Next.js). Copy to frontend/.env.local for local runs; set the same names in Vercel.

# Local only. On Vercel the `backend` service binding injects BACKEND_URL automatically.
BACKEND_URL=http://127.0.0.1:8000

# Must equal one of the backend's SUPPLYGRAPH_API_KEYS.
SUPPLYGRAPH_API_KEY=

# Optional password gate for the whole app. SESSION_SECRET must be 32+ random characters.
APP_PASSWORD=
SESSION_SECRET=

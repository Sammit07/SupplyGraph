# Backend (FastAPI). Copy to backend/.env for local runs; set the same names in Vercel.

# --- FalkorDB Cloud (console -> your instance -> Connect) ---
SUPPLYGRAPH_FALKORDB_HOST=
SUPPLYGRAPH_FALKORDB_PORT=
SUPPLYGRAPH_FALKORDB_USERNAME=falkordb
SUPPLYGRAPH_FALKORDB_PASSWORD=
# true if your instance requires TLS
SUPPLYGRAPH_FALKORDB_SSL=false
# true only for FalkorDB cluster deployments (single-node Cloud instances: false)
SUPPLYGRAPH_FALKORDB_CLUSTER=false

# --- OpenAI (analyst + PDF reading). Graph features work without it. ---
OPENAI_API_KEY=
SUPPLYGRAPH_OPENAI_MODEL=gpt-5.5
SUPPLYGRAPH_LLM_EFFORT=medium

# --- Shared secret with the Next.js server (any long random string; same value in frontend) ---
SUPPLYGRAPH_API_KEYS=

# --- Optional ---
SUPPLYGRAPH_DEFAULT_TENANT=demo
SUPPLYGRAPH_BASE_CURRENCY=USD
SUPPLYGRAPH_LOG_JSON=true
SUPPLYGRAPH_EXPOSE_DOCS=false
